```gitignore
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment and secrets
.env
.env.*
!.env.example
*.token
secrets.json
config.local.json

# Basecamp thread exports
basecamp_thread_*.txt
exports/

# Logs and temporary files
*.log
*.tmp
*.bak

# IDE and editor settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
```